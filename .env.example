# ---------------------------------------------------------------------------
# Client-visible configuration. Anything with NEXT_PUBLIC_ IS SHIPPED TO THE
# BROWSER. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Origin the app is served from. Used as the WebAuthn relying-party origin and
# must match exactly (scheme + host + port), or passkey assertions will fail.
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"
# WebAuthn relying-party ID: the registrable domain, no scheme, no port.
NEXT_PUBLIC_WEBAUTHN_RP_ID="localhost"
NEXT_PUBLIC_WEBAUTHN_RP_NAME="Crypto Inheritance Vault"

# ---------------------------------------------------------------------------
# Server-only. MUST NOT be prefixed NEXT_PUBLIC_ and MUST NOT be referenced
# from any file under src/app that renders on the client. scripts/check-crypto-leaks.mjs
# fails the build if the service-role key is reachable from client code.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Build gate. See REVIEW_GATE.md. `npm run build` refuses to run until an
# external review of the cryptographic implementation has been recorded.
# ---------------------------------------------------------------------------
CRYPTO_REVIEW_ATTESTATION=""
