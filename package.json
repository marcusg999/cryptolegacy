{
  "name": "cryptolegacy",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge crypto inheritance vault. The passphrase never leaves the browser.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:wordlist": "node scripts/verify-wordlist.mjs",
    "check:leaks": "node scripts/check-crypto-leaks.mjs",
    "gate": "node scripts/check-review-gate.mjs",
    "db:test": "supabase test db",
    "ci": "npm run verify:wordlist && npm run check:leaks && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {}
}
